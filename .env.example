# PostgreSQL used by Next.js, Drizzle, and Graphile Worker.
DATABASE_URL=postgresql://manga_hub:manga_hub_dev@127.0.0.1:5432/manga_hub

# Generate at least 32 random bytes; never commit the real value.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# The file contains `base64:<32 random bytes>` and must have mode 0600.
MANGA_HUB_KEK_FILE=.local/secrets/credential-kek-v1
MANGA_HUB_KEK_VERSION=v1

# Local development opens a visible Chromium window for source login.
AUTH_BROWSER_HEADLESS=false
WORKER_CONCURRENCY=2
